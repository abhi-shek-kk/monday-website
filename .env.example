# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/sb_aids_db?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="your-secure-jwt-secret-here-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Initial Administrator Credentials (For Database Seed)
ADMIN_INITIAL_USERNAME="adminaids"
ADMIN_INITIAL_PASSWORD="change_this_secure_admin_password_in_env"

# Cloud Storage (Cloudinary Media Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Vercel AI SDK / Google Gemini Integration
GEMINI_API_KEY="your_google_gemini_api_key"
GEMINI_MODEL="gemini-1.5-flash"
