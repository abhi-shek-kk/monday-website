datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaCategory {
  PROFILE_PHOTO
  PROJECT_IMAGE
  FACULTY_PHOTO
  GALLERY_IMAGE
  ACADEMIC_NOTE
}

enum WingType {
  NSS
  SPORTS_WING
  TECH_TEAM
  NCC
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  email        String?       @unique
  role         Role          @default(STUDENT)
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  eventsCreated  Event[]
  galleryItems   GalleryItem[]
  chatSessions   ChatSession[]
  uploadedFiles  MediaFile[]

  @@index([username])
  @@index([role])
  @@index([status])
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  registerNumber  String   @unique
  batch           String
  bio             String?  @db.Text
  profilePhotoUrl String?
  storageKey      String?
  githubUrl       String?
  linkedinUrl     String?
  websiteUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projects        Project[]
  wingMemberships StudentWingMembership[]

  @@index([registerNumber])
  @@index([batch])
}

model FacultyProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  designation     String
  qualification   String
  bio             String?  @db.Text
  profilePhotoUrl String?
  storageKey      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subjects SubjectFaculty[]
  notes    Note[]
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  semester    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculties SubjectFaculty[]
  notes     Note[]

  @@index([semester])
  @@index([code])
}

model SubjectFaculty {
  id        String         @id @default(cuid())
  facultyId String
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([facultyId, subjectId])
}

model Project {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String         @db.Text
  projectUrl  String?
  imageUrl    String?
  storageKey  String?
  isFeatured  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId])
  @@index([isFeatured])
}

model Note {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  semester    Int
  fileUrl     String
  storageKey  String?
  fileType    String?
  fileSize    Int?
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    FacultyProfile @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([subjectId])
  @@index([uploaderId])
  @@index([semester])
}

model Event {
  id          String            @id @default(cuid())
  title       String
  description String            @db.Text
  eventDate   DateTime
  location    String?
  imageUrl    String?
  storageKey  String?
  status      PublicationStatus @default(PUBLISHED)
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([eventDate])
  @@index([status])
  @@index([createdById])
}

model GalleryItem {
  id         String            @id @default(cuid())
  imageUrl   String
  storageKey String?
  caption    String?
  uploaderId String
  uploader   User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  status     PublicationStatus @default(PUBLISHED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([uploaderId])
  @@index([status])
}

model MediaFile {
  id              String        @id @default(cuid())
  storageProvider String        @default("CLOUDINARY")
  publicId        String        @unique
  url             String
  originalName    String
  mimeType        String
  size            Int
  category        MediaCategory
  uploaderId      String
  uploader        User          @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([uploaderId])
  @@index([category])
}

model Wing {
  id          String   @id @default(cuid())
  name        String   @unique
  type        WingType @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members StudentWingMembership[]
}

model StudentWingMembership {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  wingId     String
  wing       Wing           @relation(fields: [wingId], references: [id], onDelete: Cascade)
  roleInWing String?        @default("Member")
  joinedAt   DateTime       @default(now())

  @@unique([studentId, wingId])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId])
}
